# ==============================================
# Google Sheets Configuration
# ==============================================
#
# ИНСТРУКЦИЯ ПО НАСТРОЙКЕ:
# 1. Скопируйте этот файл и назовите его .env
# 2. Заполните все значения ниже реальными данными
# 3. НЕ коммитьте файл .env в репозиторий!
#
# Как получить учетные данные Google Service Account:
# 1. Перейдите на https://console.cloud.google.com
# 2. Создайте новый проект или выберите существующий
# 3. Включите Google Sheets API и Google Drive API
# 4. Создайте Service Account:
#    - Перейдите в IAM & Admin -> Service Accounts
#    - Нажмите "Create Service Account"
#    - Заполните имя и описание
#    - Нажмите "Create and Continue"
# 5. Создайте JSON ключ:
#    - Найдите созданный Service Account
#    - Перейдите в Keys -> Add Key -> Create New Key
#    - Выберите JSON формат
#    - Скачайте файл
# 6. Откройте скачанный JSON файл и скопируйте значения в переменные ниже

# ID вашего проекта Google Cloud
GOOGLE_PROJECT_ID=your-project-id-123456

# ID приватного ключа
GOOGLE_PRIVATE_KEY_ID=your_private_key_id_here

# Приватный ключ (ВАЖНО: сохраните все переносы строк как \n)
# Пример: -----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n

# Email вашего Service Account
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Client ID
GOOGLE_CLIENT_ID=123456789012345678901

# Client x509 cert URL
GOOGLE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project.iam.gserviceaccount.com

# ==============================================
# Google Sheets Spreadsheet Configuration
# ==============================================

# ID вашей Google Sheets таблицы
# Найдите его в URL таблицы:
# https://docs.google.com/spreadsheets/d/[ЭТОТ_ID_СКОПИРУЙТЕ]/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Название листа в таблице (по умолчанию "Sheet1")
GOOGLE_WORKSHEET_NAME=Sheet1

# ==============================================
# ВАЖНО!
# ==============================================
# После создания Service Account, вам нужно предоставить ему доступ к таблице:
# 1. Откройте вашу Google Sheets таблицу
# 2. Нажмите "Поделиться" (Share)
# 3. Вставьте email вашего Service Account (GOOGLE_CLIENT_EMAIL)
# 4. Дайте права "Редактор" (Editor)
# 5. Нажмите "Отправить"
